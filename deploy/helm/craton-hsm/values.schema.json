{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "daemon",
    "tls",
    "config",
    "service",
    "persistence",
    "networkPolicy"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "daemon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bind": {
          "type": "string",
          "pattern": "^([0-9.]+|\\[[0-9a-fA-F:]+\\]):[0-9]+$",
          "description": "Listen address (IP:port)"
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ]
        },
        "logFormat": {
          "type": "string",
          "enum": [
            "text",
            "json"
          ]
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 5
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "limits": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRequestBytes": {
              "type": "integer",
              "minimum": 4096,
              "maximum": 16777216
            },
            "maxResponseBytes": {
              "type": "integer",
              "minimum": 4096,
              "maximum": 16777216
            },
            "maxRandomLength": {
              "type": "integer",
              "minimum": 1
            },
            "maxDigestLength": {
              "type": "integer",
              "minimum": 1
            },
            "maxConnections": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "maxConnectionsPerIp": {
              "type": "integer",
              "minimum": 1
            },
            "maxInflightRequests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "maxConcurrentStreams": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "requestTimeoutSecs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "handshakeTimeoutSecs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            },
            "connectionIdleTimeoutSecs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400
            },
            "maxSessionsPerClient": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "sessionIdleTimeoutSecs": {
              "type": "integer",
              "minimum": 0
            },
            "maxObjectsPerClient": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "maxLoginAttempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "loginCooldownSecs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "maxBlockingTasks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            }
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "clientCaSecretName": {
          "type": "string"
        },
        "clientCrlSecretName": {
          "type": "string"
        },
        "clientCrlKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          }
        },
        "crlReloadSecs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "adminCertSha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([0-9a-fA-F]{2}:?){31}[0-9a-fA-F]{2}$"
          }
        },
        "acceptInsecure": {
          "type": "boolean",
          "description": "Explicitly acknowledge plaintext gRPC (loopback bind only). NOT recommended."
        },
        "disableMtls": {
          "type": "boolean",
          "description": "Explicitly accept TLS clients without certificates. NOT recommended."
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "storagePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$",
          "description": "Relative to /data; absolute paths and '..' are rejected by the daemon."
        },
        "auditLogPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*$"
        },
        "maxSessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxRwSessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "pinMinLength": {
          "type": "integer",
          "minimum": 4,
          "maximum": 256
        },
        "pinMaxLength": {
          "type": "integer",
          "minimum": 4,
          "maximum": 256
        },
        "maxFailedLogins": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "fipsApprovedOnly": {
          "type": "boolean"
        },
        "enablePqc": {
          "type": "boolean"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP"
          ],
          "description": "Only ClusterIP is permitted."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storageClass": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Gi|Mi|Ti)$"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientPodLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "clientNamespaceSelector": {
          "type": "object"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acceptNoLogging": {
          "type": "boolean",
          "description": "Acknowledge that audit logs are lost on pod deletion when persistence is disabled."
        }
      }
    },
    "global": {
      "type": "object"
    }
  }
}
