# Key material and signing artefacts — never commit these (H5-23).
# Integrity/release signing keys, TLS keys/certs generated for local testing,
# and the integrity signature sidecar produced by tools/sign-integrity.sh.
*.pem
*.key
*.p8
*.p12
*.pfx
*-signing-key*
*.sig
*.hmac
# Deliberate, non-secret test fixtures may be force-added (git add -f) under
# tests/fixtures/ with a README stating they are test-only material.

# Release / supply-chain outputs generated locally
*.cdx.json
*.spdx.json
SHA256SUMS
THIRD-PARTY-LICENSES*

# Local agent / tool settings (per-developer, never shared)
.claude/settings.local.json
.claude/*.local.json

# IDE / editor config
.idea/
.vscode/
*.swp
*.swo
*~

# Node.js tooling (used for doc PDF generation only)
node_modules/
bun.lock
