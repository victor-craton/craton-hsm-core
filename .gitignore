/target
/target-*/
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
/fuzz/coverage
*.redb
*.redb.lock
craton_hsm_store
craton_hsm_audit.jsonl*
rusthsm_store
rusthsm_audit.jsonl
lockout_state.json
.craton_hsm_replay_guard
.craton_hsm_replay_guard.*
*.rhbk
# Runtime state written next to a configured store / audit log (H3, H5-23):
# redb store file, keyed audit-chain sidecars (<log>.anchor, <log>.key),
# the single-writer lock (<log>.lock) and rotated generations (<log>.1 ...),
# whatever name the audit log is given in the config.
craton_hsm.redb
*.anchor
*.jsonl.lock
*.jsonl.[0-9]
*.jsonl.[0-9][0-9]

# Key material and signing artefacts — never commit these (H5-23).
# Integrity/release signing keys, TLS keys/certs generated for local testing,
# and the integrity signature sidecar produced by tools/sign-integrity.sh.
*.pem
*.key
*.p8
*.p12
*.pfx
*-signing-key*
*.sig
# ...except the known-answer-test vectors compiled into the self-tests.
!/src/crypto/kat/*.sig
*.hmac
# Deliberate, non-secret test fixtures may be force-added (git add -f) under
# tests/fixtures/ with a README stating they are test-only material.

# Release / supply-chain outputs generated locally
*.cdx.json
*.spdx.json
SHA256SUMS
THIRD-PARTY-LICENSES*

# Local agent / tool settings (per-developer, never shared)
.claude/settings.local.json
.claude/*.local.json

# IDE / editor config
.idea/
.vscode/
*.swp
*.swo
*~

# Node.js tooling (used for doc PDF generation only)
node_modules/
bun.lock
